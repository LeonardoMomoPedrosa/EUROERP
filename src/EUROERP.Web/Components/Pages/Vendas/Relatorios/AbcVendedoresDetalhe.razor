@page "/vendas/relatorios/abc/vendedores/detalhe"
@layout EUROERP.Web.Components.Layout.PopupLayout
@using EUROERP.Application.SalesReports
@using EUROERP.Web.Services
@rendermode InteractiveServer

<PageTitle>ABC - Vendedor</PageTitle>

<div class="card mb-3">
    <div class="card-header">
        <h5 class="mb-0">@(Saler ?? Agent ?? "Detalhe")</h5>
        <span class="small text-muted">@_periodLabel</span>
    </div>
    <div class="card-body">
        @if (_loading)
        {
            <p class="text-muted">Carregando...</p>
        }
        else if (_reportHtml != null)
        {
            <div class="abc-report-html">@((MarkupString)_reportHtml)</div>
        }
        else
        {
            <p class="text-muted">Dados não disponíveis.</p>
        }
    </div>
</div>

@code {
    [Parameter, SupplyParameterFromQuery] public string? Saler { get; set; }
    [Parameter, SupplyParameterFromQuery] public string? Agent { get; set; }
    [Parameter, SupplyParameterFromQuery] public int? GroupId { get; set; }
    [Parameter, SupplyParameterFromQuery] public string? GroupName { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "first")] public string? QueryFirst { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "last")] public string? QueryLast { get; set; }

    private string? _periodLabel;
    private string? _reportHtml;
    private bool _loading = true;

    [Inject] private ISalesGroupReportService ReportService { get; set; } = null!;
    [Inject] private SalesReportStateService State { get; set; } = null!;
    [Inject] private SalesReportTransformService Transform { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        // Legacy ABC Vendedores drill → mySalesResults (COMMISSION=1)
        State.SetCommissionMode(true);

        if (State.DateRange == null
            && !string.IsNullOrEmpty(QueryFirst) && !string.IsNullOrEmpty(QueryLast)
            && DateTime.TryParse(QueryFirst, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var qFirst)
            && DateTime.TryParse(QueryLast, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var qLast))
        {
            State.SetDateRange(qFirst, qLast);
        }

        if (State.DateRange != null)
            _periodLabel = $"Período: {State.DateRange.FirstDate:dd/MM/yyyy} até {State.DateRange.LastDate:dd/MM/yyyy}";

        var agent = !string.IsNullOrWhiteSpace(Saler) ? Saler : Agent;
        if (State.DateRange != null && !string.IsNullOrWhiteSpace(agent))
        {
            try
            {
                var data = await ReportService.GetMySalesReportDataAsync(State.DateRange, agent).ConfigureAwait(true);
                if (GroupId.HasValue)
                {
                    var xml = "<GROUP_REPORT>" + data.GroupReportXml + "</GROUP_REPORT>";
                    var args = new Dictionary<string, string>
                    {
                        ["groupId"] = GroupId.Value.ToString(),
                        ["agent"] = agent!,
                        ["saler"] = agent!
                    };
                    _reportHtml = Transform.Transform(xml, "invoicingByGroupSalerDetailReport.xsl", args);
                }
                else
                {
                    var xml = "<GROUP_REPORT>" + data.GroupRefReportXml + data.GroupReportXml + "</GROUP_REPORT>";
                    var args = new Dictionary<string, string>
                    {
                        ["detailPage"] = "/vendas/relatorios/minhas-vendas/detalhe",
                        ["saler"] = agent!,
                        ["agent"] = agent!,
                        ["first"] = State.DateRange.FirstDate.ToString("yyyy-MM-dd"),
                        ["last"] = State.DateRange.LastDate.ToString("yyyy-MM-dd")
                    };
                    _reportHtml = Transform.Transform(xml, "invoicingByGroupSalersReport.xsl", args);
                }
            }
            catch (Exception ex)
            {
                _reportHtml = $"<p class='text-danger'>{ex.Message}</p>";
            }
        }
        _loading = false;
    }
}
