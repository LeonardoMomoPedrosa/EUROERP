@page "/vendas/relatorios/abc/clientes/grupo"
@layout EUROERP.Web.Components.Layout.PopupLayout
@using EUROERP.Application.SalesReports
@using EUROERP.Web.Services
@rendermode InteractiveServer

<PageTitle>ABC - Cliente / Grupo</PageTitle>

<div class="card mb-3">
    <div class="card-header">
        <h5 class="mb-0">@(ClientName ?? "") — @(GroupName ?? GroupId?.ToString())</h5>
        <span class="small text-muted">@_periodLabel</span>
    </div>
    <div class="card-body">
        @if (_loading)
        {
            <p class="text-muted">Carregando...</p>
        }
        else if (_reportHtml != null)
        {
            <div class="abc-report-html">@((MarkupString)_reportHtml)</div>
        }
        else
        {
            <p class="text-muted">Dados não disponíveis.</p>
        }
    </div>
</div>

@code {
    [Parameter, SupplyParameterFromQuery] public int? ClientId { get; set; }
    [Parameter, SupplyParameterFromQuery] public int? GroupId { get; set; }
    [Parameter, SupplyParameterFromQuery] public string? ClientName { get; set; }
    [Parameter, SupplyParameterFromQuery] public string? GroupName { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "first")] public string? QueryFirst { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "last")] public string? QueryLast { get; set; }

    private string? _periodLabel;
    private string? _reportHtml;
    private bool _loading = true;

    [Inject] private ISalesGroupReportService ReportService { get; set; } = null!;
    [Inject] private SalesReportStateService State { get; set; } = null!;
    [Inject] private SalesReportTransformService Transform { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        await SalesReportPageHelper.EnsureAbcDataAsync(ReportService, State, QueryFirst, QueryLast).ConfigureAwait(true);

        if (State.DateRange != null)
            _periodLabel = $"Período: {State.DateRange.FirstDate:dd/MM/yyyy} até {State.DateRange.LastDate:dd/MM/yyyy}";

        if (ClientId.HasValue && GroupId.HasValue && State.DateRange != null)
        {
            try
            {
                var data = await ReportService.GetAbcReportDataAsync(State.DateRange, null, ClientId.Value).ConfigureAwait(true);
                var xml = "<GROUP_REPORT>" + data.GroupReportXml + "</GROUP_REPORT>";
                var args = new Dictionary<string, string>
                {
                    ["clientId"] = ClientId.Value.ToString(),
                    ["groupId"] = GroupId.Value.ToString()
                };
                _reportHtml = Transform.Transform(xml, "invoicingByGroupClientDetailReport.xsl", args);
            }
            catch (Exception ex)
            {
                _reportHtml = $"<p class='text-danger'>{ex.Message}</p>";
            }
        }
        _loading = false;
    }
}
