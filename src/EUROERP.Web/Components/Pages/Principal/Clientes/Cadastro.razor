@page "/principal/clientes/cadastro"
@using EUROERP.Application.Clients
@using EUROERP.Application.Products
@using Microsoft.AspNetCore.Components.Authorization
@rendermode InteractiveServer

<PageTitle>Clientes - Cadastro</PageTitle>

<div class="card mb-3">
    <div class="card-header">
        <h5 class="mb-0">Consultar Clientes</h5>
    </div>
    <div class="card-body">
        <div class="row g-2 mb-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label">Nome do cliente</label>
                <div class="position-relative autocomplete-wrapper">
                    <input type="text"
                           class="form-control form-control-sm"
                           placeholder="Razão social ou nome fantasia..."
                           @bind="_filter.Name"
                           @bind:event="oninput"
                           @bind:after="OnNameChanged"
                           @onblur="OnNameBlur"
                           autocomplete="off" />
                    @if (_loadingSuggestions)
                    {
                        <span class="position-absolute top-50 end-0 translate-middle-y pe-2 small text-muted">...</span>
                    }
                    @if (_showSuggestions)
                    {
                        <div class="supplier-autocomplete-dropdown position-absolute start-0 end-0 top-100 mt-1 border rounded bg-white shadow-sm border-dark" style="z-index: 9999; max-height: 200px; overflow-y: auto; min-height: 2rem;" @onmousedown="OnDropdownMouseDown" @onmousedown:preventDefault>
                            @if (_suggestions.Count == 0)
                            {
                                <div class="p-2 small text-muted">Nenhum cliente encontrado.</div>
                            }
                            else
                            {
                                @foreach (var c in _suggestions)
                                {
                                    <div class="supplier-autocomplete-item px-2 py-1 small cursor-pointer" @onmousedown="() => SelectClient(c)">
                                        <div class="fw-semibold">@c.SocialName</div>
                                        @if (!string.IsNullOrEmpty(c.FantasyName) && c.FantasyName != c.SocialName)
                                        {
                                            <div class="text-muted">@c.FantasyName</div>
                                        }
                                        @if (!string.IsNullOrEmpty(c.City) || !string.IsNullOrEmpty(c.State))
                                        {
                                            <div class="text-muted">@((string.IsNullOrEmpty(c.City) ? "" : c.City + " / ") + (c.State ?? ""))</div>
                                        }
                                    </div>
                                }
                            }
                        </div>
                    }
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label">CNPJ ou CPF</label>
                <input type="text" class="form-control form-control-sm" placeholder="Digite CNPJ ou CPF..." @bind="_filter.Cnpjpf" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Estado</label>
                <select class="form-select form-select-sm" @bind="_stateId">
                    <option value="0">Todos</option>
                    @foreach (var st in _states.Where(x => x.Id > 0))
                    {
                        <option value="@st.Id">@st.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-auto">
                <button type="button" class="btn btn-primary btn-sm" @onclick="BuscarNovo" disabled="@_loading">@(_loading ? "Buscando..." : "Buscar")</button>
            </div>
            <div class="col-md-auto">
                <a class="btn btn-success btn-sm" href="/principal/clientes/cadastro/novo">Novo cliente</a>
            </div>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="alert alert-warning">@_errorMessage</div>
}

@if (_list.Count > 0)
{
    <div class="card grid-card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-sm table-bordered mb-0 data-grid-table">
                    <thead class="table-light">
                        <tr>
                            <th>Id</th>
                            <th>Razão Social</th>
                            <th>Nome Fantasia</th>
                            <th>Localidade</th>
                            <th>Telefones</th>
                            <th>Vendedor</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in _list)
                        {
                            <tr role="button" @onclick="() => AbrirEdicao(c.Id)">
                                <td>@c.Id</td>
                                <td>@c.SocialName</td>
                                <td>@c.FantasyName</td>
                                <td>@(string.Join("/", new[] { c.City, c.State }.Where(x => !string.IsNullOrEmpty(x))))</td>
                                <td>@c.Phone</td>
                                <td>@c.Sales</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mt-2">
        <span class="text-muted small">
            Exibindo @(((_page - 1) * PageSize) + 1)–@(((_page - 1) * PageSize) + _list.Count) de @_totalCount clientes.
            Clique em um cliente para editar.
        </span>
        @if (TotalPages > 1)
        {
            <nav aria-label="Paginação de clientes">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(_page == 1 ? "disabled" : "")">
                        <button type="button" class="page-link" disabled="@(_page == 1 || _loading)" @onclick="() => IrParaPagina(1)">&laquo;</button>
                    </li>
                    <li class="page-item @(_page == 1 ? "disabled" : "")">
                        <button type="button" class="page-link" disabled="@(_page == 1 || _loading)" @onclick="() => IrParaPagina(_page - 1)">Anterior</button>
                    </li>
                    @foreach (var p in VisiblePages())
                    {
                        var target = p;
                        <li class="page-item @(target == _page ? "active" : "")">
                            <button type="button" class="page-link" disabled="@_loading" @onclick="() => IrParaPagina(target)">@target</button>
                        </li>
                    }
                    <li class="page-item @(_page == TotalPages ? "disabled" : "")">
                        <button type="button" class="page-link" disabled="@(_page == TotalPages || _loading)" @onclick="() => IrParaPagina(_page + 1)">Próxima</button>
                    </li>
                    <li class="page-item @(_page == TotalPages ? "disabled" : "")">
                        <button type="button" class="page-link" disabled="@(_page == TotalPages || _loading)" @onclick="() => IrParaPagina(TotalPages)">&raquo;</button>
                    </li>
                </ul>
            </nav>
        }
    </div>
}
else if (_searched)
{
    <p class="text-muted">Nenhum cliente encontrado.</p>
}

@code {
    private const int PageSize = 20;

    private readonly ClientFilterDto _filter = new();
    private ClientFilterDto _appliedFilter = new();
    private IReadOnlyList<IdNameDto> _states = new List<IdNameDto>();
    private int _stateId;
    private int _page = 1;
    private int _totalCount;
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_totalCount / (double)PageSize));
    private IReadOnlyList<ClientSummaryDto> _list = new List<ClientSummaryDto>();
    private string? _errorMessage;
    private bool _loading;
    private bool _searched;

    private IReadOnlyList<ClientSummaryDto> _suggestions = new List<ClientSummaryDto>();
    private bool _showSuggestions;
    private bool _loadingSuggestions;
    private bool _selectingSuggestions;
    private CancellationTokenSource? _debounceCts;

    [Inject] private IClientService ClientService { get; set; } = null!;
    [Inject] private IClientReferenceService ReferenceService { get; set; } = null!;
    [Inject] private NavigationManager Navigation { get; set; } = null!;
    [Inject] private AuthenticationStateProvider AuthStateProvider { get; set; } = null!;
    protected override async Task OnInitializedAsync()
    {
        try
        {
            _states = await ReferenceService.GetStatesAsync(1);
        }
        catch (Exception ex)
        {
            _errorMessage = "Erro ao carregar estados: " + ex.Message;
        }

        await BuscarNovo();
    }

    private async Task BuscarNovo()
    {
        _appliedFilter = new ClientFilterDto
        {
            Name = _filter.Name,
            Cnpjpf = _filter.Cnpjpf,
            StateId = _stateId > 0 ? _stateId : null
        };
        await CarregarPagina(1);
    }

    private async Task IrParaPagina(int page)
    {
        if (_loading) return;
        await CarregarPagina(Math.Clamp(page, 1, TotalPages));
    }

    private async Task CarregarPagina(int page)
    {
        _errorMessage = null;
        _loading = true;
        try
        {
            var result = await ClientService.GetPagedListAsync(_appliedFilter, page, PageSize);
            var lastPage = Math.Max(1, (int)Math.Ceiling(result.TotalCount / (double)PageSize));
            if (page > lastPage)
            {
                page = lastPage;
                result = await ClientService.GetPagedListAsync(_appliedFilter, page, PageSize);
            }

            _list = result.Items;
            _totalCount = result.TotalCount;
            _page = page;
            _searched = true;
        }
        catch (Exception ex)
        {
            _errorMessage = "Erro ao buscar: " + ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private IEnumerable<int> VisiblePages()
    {
        const int window = 2;
        var start = Math.Max(1, _page - window);
        var end = Math.Min(TotalPages, _page + window);
        for (var i = start; i <= end; i++)
            yield return i;
    }

    private async Task OnNameChanged()
    {
        _showSuggestions = _filter.Name.Trim().Length >= 2;
        _debounceCts?.Cancel();
        _debounceCts = new CancellationTokenSource();
        var ct = _debounceCts.Token;

        if (_filter.Name.Trim().Length < 2)
        {
            _suggestions = new List<ClientSummaryDto>();
            StateHasChanged();
            return;
        }

        try
        {
            await Task.Delay(300, ct);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        _loadingSuggestions = true;
        StateHasChanged();
        try
        {
            var list = await ClientService.GetSuggestionsAsync(_filter.Name.Trim(), 10, ct);
            if (!ct.IsCancellationRequested)
            {
                _suggestions = list;
                _showSuggestions = true;
            }
        }
        catch (OperationCanceledException) { }
        finally
        {
            if (!ct.IsCancellationRequested)
            {
                _loadingSuggestions = false;
                StateHasChanged();
            }
        }
    }

    private async Task OnNameBlur()
    {
        await Task.Delay(150);
        if (!_selectingSuggestions)
            _showSuggestions = false;
        _selectingSuggestions = false;
        StateHasChanged();
    }

    private void OnDropdownMouseDown(MouseEventArgs _) => _selectingSuggestions = true;

    private void SelectClient(ClientSummaryDto c)
    {
        _selectingSuggestions = true;
        _showSuggestions = false;
        _suggestions = new List<ClientSummaryDto>();
        Navigation.NavigateTo($"/principal/clientes/cadastro/{c.Id}");
    }

    private void AbrirEdicao(int id)
    {
        Navigation.NavigateTo($"/principal/clientes/cadastro/{id}");
    }
}
