@page "/diretoria/atividades/gerenciar"
@using EUROERP.Application.Activities
@attribute [Authorize]
@rendermode InteractiveServer

<PageTitle>Gerenciar atividades</PageTitle>

<div class="card mb-3">
    <div class="card-header">
        <h5 class="mb-0">Atividades</h5>
    </div>
    <div class="card-body">
        @if (!string.IsNullOrEmpty(_message))
        {
            <div class="alert @(_messageSuccess ? "alert-success" : "alert-danger") py-2 mb-2">@_message</div>
        }

        <div class="row">
            <div class="col-12 col-lg-8">
                <div class="table-responsive">
                    <table class="table table-sm table-hover table-bordered table-list">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 8rem;">Código</th>
                                <th>Descrição</th>
                                <th style="width: 10rem;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_loading)
                            {
                                <tr><td colspan="3" class="text-center text-muted">Carregando...</td></tr>
                            }
                            else if (_activities.Count == 0)
                            {
                                <tr><td colspan="3" class="text-center text-muted">Nenhuma atividade cadastrada.</td></tr>
                            }
                            else
                            {
                                @foreach (var a in _activities)
                                {
                                    <tr>
                                        @if (_editingId == a.ActvId)
                                        {
                                            <td><input type="text" class="form-control form-control-sm" @bind="_editCode" maxlength="8" /></td>
                                            <td><input type="text" class="form-control form-control-sm" @bind="_editDescription" maxlength="30" /></td>
                                            <td class="align-middle">
                                                <button type="button" class="btn btn-sm btn-primary" @onclick="SaveEditAsync" disabled="@_saving">Salvar</button>
                                                <button type="button" class="btn btn-sm btn-secondary ms-1" @onclick="CancelEdit">Cancelar</button>
                                            </td>
                                        }
                                        else
                                        {
                                            <td class="align-middle">@a.Code</td>
                                            <td class="align-middle">@a.Description</td>
                                            <td class="align-middle">
                                                <button type="button" class="btn btn-link btn-sm p-0 text-primary" @onclick="() => StartEdit(a)">Alterar</button>
                                                <span class="mx-1">|</span>
                                                <button type="button" class="btn btn-link btn-sm p-0 text-danger" @onclick="() => DeleteAsync(a.ActvId, a.Code)">Excluir</button>
                                            </td>
                                        }
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="col-12 col-lg-4 mt-3 mt-lg-0">
                <div class="border rounded p-3 bg-light">
                    <h6 class="mb-3">Nova atividade</h6>
                    <label class="form-label">Código * <span class="text-muted small">(máx. 8)</span></label>
                    <input type="text" class="form-control form-control-sm" @bind="_newCode" maxlength="8" />
                    <label class="form-label mt-2">Descrição * <span class="text-muted small">(máx. 30)</span></label>
                    <input type="text" class="form-control form-control-sm" @bind="_newDescription" maxlength="30" />
                    <div class="mt-3">
                        <button type="button" class="btn btn-primary btn-sm" @onclick="CreateAsync" disabled="@_creating">@(_creating ? "Criando..." : "Criar")</button>
                    </div>
                </div>
                <p class="small text-muted mt-3 mb-0">Associe as atividades às funções em <a href="/diretoria/atividades/associar">Associar</a>.</p>
            </div>
        </div>
    </div>
</div>

@code {
    private List<ActivityDto> _activities = new();
    private bool _loading = true;
    private string _newCode = "";
    private string _newDescription = "";
    private bool _creating;
    private int? _editingId;
    private string _editCode = "";
    private string _editDescription = "";
    private bool _saving;
    private string? _message;
    private bool _messageSuccess;

    [Inject] private IActivityService ActivityService { get; set; } = null!;
    [Inject] private IJSRuntime JSRuntime { get; set; } = null!;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();
        try
        {
            _activities = (await ActivityService.ListActivitiesAsync()).ToList();
        }
        catch (Exception ex)
        {
            _message = ex.Message;
            _messageSuccess = false;
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task CreateAsync()
    {
        _creating = true;
        _message = null;
        try
        {
            var result = await ActivityService.CreateAsync(_newCode, _newDescription);
            _message = result.Message;
            _messageSuccess = result.Success;
            if (result.Success)
            {
                _newCode = _newDescription = "";
                await LoadAsync();
            }
        }
        catch (Exception ex)
        {
            _message = ex.Message;
            _messageSuccess = false;
        }
        finally
        {
            _creating = false;
            StateHasChanged();
        }
    }

    private void StartEdit(ActivityDto a)
    {
        _editingId = a.ActvId;
        _editCode = a.Code;
        _editDescription = a.Description;
        _message = null;
        StateHasChanged();
    }

    private void CancelEdit()
    {
        _editingId = null;
        StateHasChanged();
    }

    private async Task SaveEditAsync()
    {
        if (!_editingId.HasValue) return;
        _saving = true;
        _message = null;
        try
        {
            var result = await ActivityService.UpdateAsync(_editingId.Value, _editCode, _editDescription);
            _message = result.Message;
            _messageSuccess = result.Success;
            if (result.Success)
            {
                _editingId = null;
                await LoadAsync();
            }
        }
        catch (Exception ex)
        {
            _message = ex.Message;
            _messageSuccess = false;
        }
        finally
        {
            _saving = false;
            StateHasChanged();
        }
    }

    private async Task DeleteAsync(int actvId, string code)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", $"Excluir a atividade \"{code}\"?"))
            return;
        _message = null;
        try
        {
            var result = await ActivityService.DeleteAsync(actvId);
            _message = result.Message;
            _messageSuccess = result.Success;
            if (result.Success) await LoadAsync();
        }
        catch (Exception ex)
        {
            _message = ex.Message;
            _messageSuccess = false;
        }
        StateHasChanged();
    }
}
