@page "/diretoria/usuarios/novo"
@using EUROERP.Application.UserManagement
@attribute [Authorize]
@rendermode InteractiveServer

<PageTitle>Novo usuário</PageTitle>

<div class="card mb-3">
    <div class="card-header">
        <h5 class="mb-0">Novo usuário</h5>
    </div>
    <div class="card-body">
        @if (!string.IsNullOrEmpty(_message))
        {
            <div class="alert @(_messageSuccess ? "alert-success" : "alert-danger") py-2 mb-3">@_message</div>
        }

        <div class="row g-2">
            <div class="col-12 col-md-4">
                <label class="form-label">Nome de usuário *</label>
                <input type="text" class="form-control form-control-sm" @bind="_userName" maxlength="256" placeholder="Login" />
                <span class="text-danger small">@_userNameError</span>
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label">E-mail</label>
                <input type="text" class="form-control form-control-sm" @bind="_email" maxlength="256" />
            </div>
        </div>
        <div class="row g-2 mt-1">
            <div class="col-12 col-md-4">
                <label class="form-label">Senha *</label>
                <input type="password" class="form-control form-control-sm" @bind="_password" maxlength="10" autocomplete="new-password" />
                <span class="text-danger small">@_passwordError</span>
                <span class="small text-muted d-block">7 a 10 caracteres, letras e números</span>
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label">Confirmar senha *</label>
                <input type="password" class="form-control form-control-sm" @bind="_confirmPassword" maxlength="10" autocomplete="new-password" />
                <span class="text-danger small">@_confirmError</span>
            </div>
        </div>
        <div class="mt-3">
            <button type="button" class="btn btn-primary btn-sm" @onclick="CreateAsync" disabled="@_creating">@(_creating ? "Criando..." : "Criar usuário")</button>
            <a class="btn btn-outline-secondary btn-sm ms-1" href="/diretoria/usuarios/funcoes">Definir funções</a>
        </div>
        <p class="small text-muted mt-3 mb-0">O usuário é criado com acesso ao mercado nacional. Ajuste os mercados em <a href="/diretoria/usuarios/mercados">Mercados</a>.</p>
    </div>
</div>

@code {
    private string _userName = "";
    private string _email = "";
    private string _password = "";
    private string _confirmPassword = "";
    private string? _userNameError;
    private string? _passwordError;
    private string? _confirmError;
    private bool _creating;
    private string? _message;
    private bool _messageSuccess;

    [Inject] private IUserManagementService UserManagement { get; set; } = null!;

    private bool Validate()
    {
        _userNameError = _passwordError = _confirmError = null;
        var ok = true;
        if (string.IsNullOrWhiteSpace(_userName))
        {
            _userNameError = "Nome de usuário é obrigatório.";
            ok = false;
        }
        if (string.IsNullOrEmpty(_password))
        {
            _passwordError = "Senha é obrigatória.";
            ok = false;
        }
        else if (_password.Length < 7 || _password.Length > 10)
        {
            _passwordError = "Senha deve ter entre 7 e 10 caracteres.";
            ok = false;
        }
        else if (!_password.Any(char.IsLetter) || !_password.Any(char.IsDigit))
        {
            _passwordError = "Senha deve conter letras e números.";
            ok = false;
        }
        if (_password != _confirmPassword)
        {
            _confirmError = "As senhas não coincidem.";
            ok = false;
        }
        return ok;
    }

    private async Task CreateAsync()
    {
        if (!Validate())
        {
            StateHasChanged();
            return;
        }
        _creating = true;
        _message = null;
        try
        {
            var result = await UserManagement.CreateUserAsync(
                _userName.Trim(),
                string.IsNullOrWhiteSpace(_email) ? null : _email.Trim(),
                _password);
            _message = result.Message;
            _messageSuccess = result.Success;
            if (result.Success)
                _userName = _email = _password = _confirmPassword = "";
        }
        catch (Exception ex)
        {
            _message = ex.Message;
            _messageSuccess = false;
        }
        finally
        {
            _creating = false;
            StateHasChanged();
        }
    }
}
