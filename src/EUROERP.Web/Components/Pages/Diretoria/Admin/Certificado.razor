@page "/diretoria/admin/certificado"
@using System.Globalization
@using EUROERP.Application.NFe
@using EUROERP.Infrastructure.NFe
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@attribute [Authorize]
@rendermode InteractiveServer

<PageTitle>Certificado</PageTitle>

<div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Certificado NFe / NFES</h5>
    </div>
    <div class="card-body">
        <p class="text-muted small mb-3">
            Este certificado digital é usado na emissão de <strong>NFe (produtos)</strong> e <strong>NFES (serviços)</strong>.
            Após o upload, a ativação é imediata para ambos.
        </p>

        @if (_loading)
        {
            <p class="text-muted mb-3">Carregando informações do certificado...</p>
        }
        else if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="alert alert-danger mb-3 py-2">@_error</div>
        }
        else if (_certificate is null)
        {
            <div class="alert alert-warning mb-3 py-2">Certificado não encontrado.</div>
        }
        else
        {
            <div class="row g-3 align-items-start mb-3">
                <div class="col-12">
                    <dl class="row mb-0">
                        <dt class="col-sm-3 text-muted">Emitente</dt>
                        <dd class="col-sm-9 text-break">@_certificate.Subject</dd>

                        <dt class="col-sm-3 text-muted">Autoridade</dt>
                        <dd class="col-sm-9 text-break">@_certificate.Issuer</dd>

                        <dt class="col-sm-3 text-muted">Thumbprint</dt>
                        <dd class="col-sm-9 text-break">@_certificate.Thumbprint</dd>

                        <dt class="col-sm-3 text-muted">Válido de</dt>
                        <dd class="col-sm-9">@_certificate.NotBefore.ToString("dd/MM/yyyy HH:mm", CultureInfo.InvariantCulture)</dd>

                        <dt class="col-sm-3 text-muted">Válido até</dt>
                        <dd class="col-sm-9">@_certificate.NotAfter.ToString("dd/MM/yyyy HH:mm", CultureInfo.InvariantCulture)</dd>

                        <dt class="col-sm-3 text-muted">Situação</dt>
                        <dd class="col-sm-9">
                            @if (_isExpired)
                            {
                                <span class="badge bg-danger">Vencido</span>
                            }
                            else if (_isExpiringSoon)
                            {
                                <span class="badge bg-warning text-dark">Próximo do vencimento</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Válido</span>
                            }
                        </dd>

                        <dt class="col-sm-3 text-muted">Dias restantes</dt>
                        <dd class="col-sm-9">@_remainingDaysText</dd>
                    </dl>
                </div>
            </div>
        }

        <div class="border rounded p-3 bg-light" style="max-width: 32rem;">
            <h6 class="mb-3">@(_certificate is null ? "Enviar certificado" : "Atualizar certificado")</h6>
            @if (!string.IsNullOrWhiteSpace(_uploadMessage))
            {
                <div class="alert @(_uploadSuccess ? "alert-success" : "alert-danger") py-2 mb-2">@_uploadMessage</div>
            }
            <div class="mb-2">
                <label class="form-label">Arquivo (.pfx / .p12)</label>
                <InputFile OnChange="OnFileSelected" class="form-control form-control-sm" accept=".pfx,.p12" />
                @if (!string.IsNullOrWhiteSpace(_selectedFileName))
                {
                    <div class="form-text">Selecionado: @_selectedFileName</div>
                }
            </div>
            <div class="mb-2">
                <label class="form-label">Senha do certificado</label>
                <input type="password" class="form-control form-control-sm" @bind="_newPassword" maxlength="256" autocomplete="new-password" />
            </div>
            <button type="button" class="btn btn-primary btn-sm" @onclick="UploadCertificateAsync" disabled="@_uploading">
                @(_uploading ? "Atualizando..." : "Atualizar Certificado")
            </button>
            <div class="form-text mt-2">Após validar e salvar, este certificado será usado imediatamente em NFe e NFES.</div>
        </div>
    </div>
</div>

@code {
    [Inject] private INfeCertificateProvider CertificateProvider { get; set; } = null!;
    [Inject] private INfeCertificateAdminService CertificateAdminService { get; set; } = null!;
    [Inject] private AuthenticationStateProvider AuthStateProvider { get; set; } = null!;
    [Inject] private NavigationManager Navigation { get; set; } = null!;

    private bool _loading = true;
    private string? _error;
    private System.Security.Cryptography.X509Certificates.X509Certificate2? _certificate;
    private bool _isExpired;
    private bool _isExpiringSoon;
    private string _remainingDaysText = "—";
    private IBrowserFile? _selectedFile;
    private string _selectedFileName = string.Empty;
    private string _newPassword = string.Empty;
    private bool _uploading;
    private string? _uploadMessage;
    private bool _uploadSuccess;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync().ConfigureAwait(false);
        var user = auth.User;
        if (!(user.IsInRole("Admin") || user.IsInRole("SysAdmin") || user.IsInRole("Master")))
        {
            Navigation.NavigateTo("/acesso-negado", forceLoad: true);
            return;
        }

        await LoadCertificateAsync().ConfigureAwait(false);
    }

    private Task LoadCertificateAsync()
    {
        _loading = true;
        _error = null;
        _certificate = null;
        _isExpired = false;
        _isExpiringSoon = false;
        _remainingDaysText = "—";
        try
        {
            _certificate = CertificateProvider.GetCertificate();
            var now = DateTime.Now;
            _isExpired = _certificate.NotAfter < now;
            _isExpiringSoon = !_isExpired && (_certificate.NotAfter - now).TotalDays <= 45;

            var remaining = _certificate.NotAfter - now;
            _remainingDaysText = _isExpired
                ? "0 (vencido)"
                : Math.Max(0, (int)Math.Floor(remaining.TotalDays)).ToString(CultureInfo.InvariantCulture);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }

        return Task.CompletedTask;
    }

    private void OnFileSelected(InputFileChangeEventArgs args)
    {
        _selectedFile = args.File;
        _selectedFileName = _selectedFile?.Name ?? string.Empty;
    }

    private async Task UploadCertificateAsync()
    {
        _uploadMessage = null;
        _uploadSuccess = false;

        if (_selectedFile is null)
        {
            _uploadMessage = "Selecione um arquivo .pfx.";
            return;
        }
        if (string.IsNullOrWhiteSpace(_newPassword))
        {
            _uploadMessage = "Informe a senha do certificado.";
            return;
        }

        _uploading = true;
        try
        {
            var maxBytes = 5 * 1024 * 1024;
            await using var stream = _selectedFile.OpenReadStream(maxBytes);
            using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);
            var content = memoryStream.ToArray();

            var result = await CertificateAdminService
                .ValidateAndStoreAsync(content, _selectedFile.Name, _newPassword)
                .ConfigureAwait(false);

            if (result.Success && !string.IsNullOrWhiteSpace(result.StoredPath))
            {
                result = await CertificateAdminService
                    .ActivateStoredCertificateAsync(result.StoredPath, _newPassword)
                    .ConfigureAwait(false);
            }

            _uploadSuccess = result.Success;
            _uploadMessage = result.Success
                ? (result.Message.Contains("NFe", StringComparison.OrdinalIgnoreCase)
                    ? result.Message
                    : result.Message + " (válido para NFe e NFES).")
                : result.Message;

            if (result.Success)
            {
                _selectedFile = null;
                _selectedFileName = string.Empty;
                _newPassword = string.Empty;
                await LoadCertificateAsync().ConfigureAwait(false);
            }
        }
        catch (IOException)
        {
            _uploadMessage = "Arquivo maior que o limite permitido (5 MB).";
        }
        catch (Exception ex)
        {
            _uploadMessage = ex.Message;
        }
        finally
        {
            _uploading = false;
            await InvokeAsync(StateHasChanged);
        }
    }
}
