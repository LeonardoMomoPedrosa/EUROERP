@page "/financeiro/faturamento/mensal/geral"
@using EUROERP.Application.RevenueReporting
@rendermode InteractiveServer

<PageTitle>Faturamento - Mensal - Geral</PageTitle>

<div class="card mb-3">
    <div class="card-header">
        <h5 class="mb-0">Faturamento Mensal</h5>
    </div>
    <div class="card-body">
        @if (!string.IsNullOrEmpty(_validationError))
        {
            <div class="alert alert-warning py-2 mb-2">@_validationError</div>
        }
        <p class="mb-2">Digite o mês e ano:</p>
        <div class="row g-3 align-items-end">
            <div class="col-12 col-md-6 col-lg-2">
                <label class="form-label">Mês <span class="text-danger">*</span></label>
                <input type="number" class="form-control form-control-sm" @bind="_month" min="1" max="12" placeholder="1-12" />
            </div>
            <div class="col-12 col-md-6 col-lg-2">
                <label class="form-label">Ano <span class="text-danger">*</span></label>
                <input type="number" class="form-control form-control-sm" @bind="_year" min="2006" max="2030" placeholder="Ex: 2025" />
            </div>
            <div class="col-12 col-md-6 col-lg-2">
                <button type="button" class="btn btn-primary btn-sm" @onclick="Search" disabled="@_loading">@(_loading ? "Buscando..." : "Buscar")</button>
            </div>
        </div>
    </div>
</div>

@if (_result != null)
{
    <div class="card small">
        <div class="card-header">
            <h6 class="mb-0">Faturamento Mensal — @_result.Month / @_result.Year</h6>
        </div>
        <div class="card-body p-0 overflow-auto">
            <table class="table table-sm table-hover table-striped mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Data</th>
                        <th class="text-center">Env</th>
                        <th class="text-end text-nowrap">Loja R$</th>
                        <th class="text-end text-nowrap">Site</th>
                        <th class="text-end text-nowrap">ML</th>
                        <th class="text-end text-nowrap">Dev. R$</th>
                        <th class="text-end text-nowrap">Créd</th>
                        <th class="text-end text-nowrap">Baixa</th>
                        <th class="text-end text-nowrap">Uso</th>
                        <th class="text-end text-nowrap">F/P.</th>
                        <th class="text-end text-nowrap">Mort. M.</th>
                        <th class="text-end text-nowrap">Mort. D</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _result.Days)
                    {
                        <tr>
                            <td>
                                <a href="@GetDailyUrl(row.Date)">@row.Date</a>
                            </td>
                            <td class="text-center">@row.EnvCount</td>
                            <td class="text-end text-nowrap">@row.LojaAmount.ToString("N2", _ptBr)</td>
                            <td class="text-end text-nowrap">@row.SiteAmount.ToString("N2", _ptBr)</td>
                            <td class="text-end text-nowrap">@row.MeliAmount.ToString("N2", _ptBr)</td>
                            <td class="text-end text-nowrap">@row.DevAmount.ToString("N2", _ptBr)</td>
                            <td class="text-end text-nowrap">@row.CreditAmount.ToString("N2", _ptBr)</td>
                            <td class="text-end text-nowrap">@row.BaixaAmount.ToString("N2", _ptBr)</td>
                            <td class="text-end text-nowrap">@row.UsoAmount.ToString("N2", _ptBr)</td>
                            <td class="text-end text-nowrap">@row.FpAmount.ToString("N2", _ptBr)</td>
                            <td class="text-end text-nowrap">@row.MortMAmount.ToString("N2", _ptBr)</td>
                            <td class="text-end text-nowrap">@row.MortDAmount.ToString("N2", _ptBr)</td>
                        </tr>
                    }
                    @if (_result.Days.Count == 0)
                    {
                        <tr>
                            <td colspan="12" class="text-center text-muted py-3">Nenhum lançamento encontrado.</td>
                        </tr>
                    }
                </tbody>
                <tfoot class="table-light">
                    <tr>
                        <td></td>
                        <td class="text-center"><strong>@_result.Days.Sum(x => x.EnvCount)</strong></td>
                        <td class="text-end text-nowrap"><strong>@_result.TotalLoja.ToString("N2", _ptBr)</strong></td>
                        <td class="text-end text-nowrap"><strong>@_result.TotalSite.ToString("N2", _ptBr)</strong></td>
                        <td class="text-end text-nowrap"><strong>@_result.TotalMeli.ToString("N2", _ptBr)</strong></td>
                        <td class="text-end text-nowrap"><strong>@_result.TotalDev.ToString("N2", _ptBr)</strong></td>
                        <td class="text-end text-nowrap"><strong>@_result.TotalCredit.ToString("N2", _ptBr)</strong></td>
                        <td class="text-end text-nowrap"><strong>@_result.TotalBaixa.ToString("N2", _ptBr)</strong></td>
                        <td class="text-end text-nowrap"><strong>@_result.TotalUso.ToString("N2", _ptBr)</strong></td>
                        <td class="text-end text-nowrap"><strong>@_result.TotalFp.ToString("N2", _ptBr)</strong></td>
                        <td class="text-end text-nowrap"><strong>@_result.TotalMortM.ToString("N2", _ptBr)</strong></td>
                        <td class="text-end text-nowrap"><strong>@_result.TotalMortD.ToString("N2", _ptBr)</strong></td>
                    </tr>
                    <tr>
                        <td class="text-end">Dev.</td>
                        <td></td>
                        <td class="text-end text-nowrap">@_result.TotalDev.ToString("N2", _ptBr)</td>
                        <td colspan="8"></td>
                    </tr>
                    <tr>
                        <td class="text-end"><strong>Total</strong></td>
                        <td></td>
                        <td class="text-end text-nowrap"><strong>@((_result.TotalLoja - _result.TotalDev).ToString("N2", _ptBr))</strong></td>
                        <td colspan="8"></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
}

@code {
    private static readonly System.Globalization.CultureInfo _ptBr = System.Globalization.CultureInfo.GetCultureInfo("pt-BR");
    private int _month = DateTime.Today.Month;
    private int _year = DateTime.Today.Year;
    private bool _loading;
    private string? _validationError;
    private MonthlyRevenueResultDto? _result;

    [Inject] private IRevenueReportMonthlyService ReportService { get; set; } = null!;
    [Inject] private NavigationManager Navigation { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        var uri = new Uri(Navigation.Uri);
        var query = ParseQueryString(uri.Query);
        if (query.TryGetValue("month", out var monthStr) && query.TryGetValue("year", out var yearStr)
            && int.TryParse(monthStr, out var m) && int.TryParse(yearStr, out var y)
            && m >= 1 && m <= 12 && y >= 2006 && y <= 2030)
        {
            _month = m;
            _year = y;
            await Search();
        }
    }

    private static Dictionary<string, string> ParseQueryString(string query)
    {
        var dict = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        if (string.IsNullOrEmpty(query) || query[0] != '?') return dict;
        foreach (var pair in query[1..].Split('&'))
        {
            var idx = pair.IndexOf('=');
            if (idx <= 0) continue;
            var key = Uri.UnescapeDataString(pair[0..idx].Trim());
            var value = Uri.UnescapeDataString(pair[(idx + 1)..].Trim());
            dict[key] = value;
        }
        return dict;
    }

    private string GetDailyUrl(string dateDdMmYyyy)
    {
        return $"/financeiro/faturamento/diario?date={Uri.EscapeDataString(dateDdMmYyyy)}";
    }

    private async Task Search()
    {
        _validationError = null;
        _result = null;
        if (_month < 1 || _month > 12)
        {
            _validationError = "Mês inválido. Informe um valor entre 1 e 12.";
            return;
        }
        if (_year < 2006 || _year > 2030)
        {
            _validationError = "Ano inválido. Informe um valor entre 2006 e 2030.";
            return;
        }

        _loading = true;
        try
        {
            var criteria = new MonthlyRevenueCriteriaDto
            {
                Month = (byte)_month,
                Year = _year
            };
            _result = await ReportService.GetMonthlyRevenueReportAsync(criteria);
        }
        finally
        {
            _loading = false;
        }
    }
}
