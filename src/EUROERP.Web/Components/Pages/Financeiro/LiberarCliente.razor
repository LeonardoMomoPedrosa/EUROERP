@page "/financeiro/liberar-cliente"
@using EUROERP.Application.ClearCustomer
@using EUROERP.Application.Clients
@using Microsoft.AspNetCore.Components.Authorization
@rendermode InteractiveServer

<PageTitle>Financeiro - Liberar Cliente</PageTitle>

<div class="card mb-3">
    <div class="card-header">
        <h5 class="mb-0">Liberar Cliente</h5>
    </div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-12 col-md-6 col-lg-5">
                <label class="form-label">Nome do cliente</label>
                <div class="input-group input-group-sm">
                    <input type="text" class="form-control" placeholder="Nome do CLIENTE" @bind="_clientName" />
                    <button type="button" class="btn btn-outline-primary" @onclick="Buscar" disabled="@_loadingSearch">Busca</button>
                </div>
            </div>
        </div>

        @if (_clientList.Count > 0)
        {
            <div class="table-responsive mt-3">
                <table class="table table-sm table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Nome</th>
                            <th>Nome fantasia</th>
                            <th>Localidade</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in _clientList)
                        {
                            <tr role="button" class="@(_selectedClient?.Id == c.Id ? "table-primary" : "")" @onclick="() => SelectClient(c)">
                                <td class="small">@c.SocialName</td>
                                <td class="small">@(c.FantasyName ?? "—")</td>
                                <td class="small">@(c.City ?? "—") / @(c.State ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @if (_selectedClient != null)
        {
            <div class="mt-3 pt-3 border-top">
                @if (!string.IsNullOrEmpty(_message))
                {
                    <p class="mb-2 fw-bold @(_isSuccess ? "text-success" : "text-muted")">@_message</p>
                }
                @if (_showAllowButton)
                {
                    <button type="button" class="btn btn-primary btn-sm" @onclick="ExecutarLiberacao" disabled="@_loadingAllow">@(_loadingAllow ? "Processando..." : "Liberar Cliente")</button>
                }
            </div>
        }
    </div>
</div>

@code {
    private string _clientName = "";
    private List<ClientSummaryDto> _clientList = new();
    private ClientSummaryDto? _selectedClient;
    private bool _loadingSearch;
    private bool _loadingAllow;
    private string? _message;
    private bool _isSuccess;
    private bool _showAllowButton;
    private string? _currentUserName;

    [Inject] private IClientService ClientService { get; set; } = null!;
    [Inject] private IClearCustomerService ClearCustomerService { get; set; } = null!;
    [Inject] private AuthenticationStateProvider AuthStateProvider { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        _currentUserName = state.User.Identity?.Name ?? "SYS";
    }

    private async Task Buscar()
    {
        _loadingSearch = true;
        _selectedClient = null;
        _message = null;
        _showAllowButton = false;
        try
        {
            _clientList = (await ClientService.GetListAsync(new ClientFilterDto { Name = _clientName })).ToList();
        }
        finally
        {
            _loadingSearch = false;
        }
    }

    private async Task SelectClient(ClientSummaryDto client)
    {
        _selectedClient = client;
        _message = null;
        _showAllowButton = false;
        try
        {
            var isDelinquent = await ClearCustomerService.IsClientDelinquentAsync(client.Id);
            if (isDelinquent)
            {
                _showAllowButton = true;
                _message = null;
            }
            else
            {
                _message = "Este cliente não é devedor";
                _isSuccess = false;
            }
        }
        catch (Exception ex)
        {
            _message = "Erro ao verificar: " + ex.Message;
            _isSuccess = false;
        }
    }

    private async Task ExecutarLiberacao()
    {
        if (_selectedClient == null || string.IsNullOrEmpty(_currentUserName)) return;
        _loadingAllow = true;
        _message = null;
        try
        {
            await ClearCustomerService.AllowDelinquentClientAsync(_selectedClient.Id, _currentUserName);
            _message = "O cliente foi liberado por 24 horas";
            _isSuccess = true;
            _showAllowButton = false;
        }
        catch (Exception ex)
        {
            _message = "Erro ao liberar: " + ex.Message;
            _isSuccess = false;
        }
        finally
        {
            _loadingAllow = false;
        }
    }
}
