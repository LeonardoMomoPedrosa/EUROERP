@page "/financeiro/contas-a-pagar/alterar-pedido"
@using EUROERP.Application.AccountsPayable
@rendermode InteractiveServer

<PageTitle>Alterar data do pedido</PageTitle>

<div class="card">
    <div class="card-header"><h5 class="mb-0">Alterar data do pedido</h5></div>
    <div class="card-body">
        @if (_error != null) { <div class="alert alert-danger">@_error</div> }
        @if (_detail == null && _error == null && _billId > 0)
        { <p class="text-muted">Carregando...</p> }
        @if (_detail != null)
        {
            <p class="small">Lançamento @_billId — @_detail.SupplierName</p>
            <div class="row g-2">
                <div class="col-12 col-md-4">
                    <label class="form-label">Nova data do pedido</label>
                    <input id="orderDate" type="text" class="form-control form-control-sm date-mask-ddmmyyyy" value="@_orderDateText" @onblur="SyncOrderDate" placeholder="dd/MM/yyyy" maxlength="10" />
                </div>
            </div>
            <div class="mt-3">
                <button type="button" class="btn btn-primary btn-sm" @onclick="Save" disabled="@_saving">@(_saving ? "Salvando..." : "Salvar")</button>
                <a href="/financeiro/contas-a-pagar/consultar" class="btn btn-secondary btn-sm ms-2">Voltar</a>
            </div>
        }
    </div>
</div>

@code {
    private static readonly System.Globalization.CultureInfo _ptBr = System.Globalization.CultureInfo.GetCultureInfo("pt-BR");
    private int _billId;
    private BillToPayDetailDto? _detail;
    private string _orderDateText = "";
    private bool _saving;
    private string? _error;

    [Inject] private IUpdateBillsToPayService UpdateService { get; set; } = null!;
    [Inject] private NavigationManager Navigation { get; set; } = null!;
    [Inject] private IJSRuntime JSRuntime { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var q = ParseQuery(uri.Query);
        if (!int.TryParse(q.GetValueOrDefault("IDL"), out _billId) || _billId <= 0)
        {
            _error = "Parâmetro IDL é obrigatório.";
            return;
        }
        var termNo = byte.TryParse(q.GetValueOrDefault("TERM_NO"), out var tn) ? tn : (byte)1;
        _detail = await UpdateService.GetDetailAsync(_billId, termNo);
        if (_detail == null) { _error = "Lançamento não encontrado."; return; }
        _orderDateText = _detail.OrderDate?.ToString("dd/MM/yyyy", _ptBr) ?? DateTime.Today.ToString("dd/MM/yyyy", _ptBr);
    }

    private async Task SyncOrderDate()
    {
        try { var v = await JSRuntime.InvokeAsync<string>("euroerpGetDateInputValue", "orderDate"); if (v != null) _orderDateText = v; } catch { }
        StateHasChanged();
    }

    private static DateTime? ParseDate(string? t)
    {
        if (string.IsNullOrWhiteSpace(t)) return null;
        if (DateTime.TryParseExact(t.Trim(), "dd/MM/yyyy", _ptBr, System.Globalization.DateTimeStyles.None, out var d)) return d;
        return DateTime.TryParse(t, _ptBr, System.Globalization.DateTimeStyles.None, out d) ? d : null;
    }

    private async Task Save()
    {
        await SyncOrderDate();
        var d = ParseDate(_orderDateText);
        if (!d.HasValue) { _error = "Data inválida (dd/MM/yyyy)."; return; }
        _saving = true; _error = null;
        try
        {
            await UpdateService.UpdateOrderDateAsync(_billId, d.Value);
            Navigation.NavigateTo("/financeiro/contas-a-pagar/consultar", forceLoad: true);
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _saving = false; StateHasChanged(); }
    }

    private static Dictionary<string, string> ParseQuery(string query)
    {
        var d = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        foreach (var part in (query ?? "").TrimStart('?').Split('&'))
        { var kv = part.Split('=', 2, StringSplitOptions.None); if (kv.Length == 2 && !string.IsNullOrEmpty(kv[0])) d[kv[0].Trim()] = Uri.UnescapeDataString(kv[1].Trim()); }
        return d;
    }
}
