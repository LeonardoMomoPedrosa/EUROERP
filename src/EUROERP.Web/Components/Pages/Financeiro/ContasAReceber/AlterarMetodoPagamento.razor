@page "/financeiro/contas-a-receber/alterar-metodo-pagamento"
@using EUROERP.Application.AccountsReceivable
@using EUROERP.Application.Clients
@using EUROERP.Application.Products
@rendermode InteractiveServer

<PageTitle>Alterar método de pagamento</PageTitle>

<div class="card">
    <div class="card-header"><h5 class="mb-0">Alterar método de pagamento</h5></div>
    <div class="card-body">
        @if (_error != null) { <div class="alert alert-danger">@_error</div> }
        @if (_blockedMessage != null) { <div class="alert alert-warning">@_blockedMessage</div> }
        @if (_detail == null && _error == null && _btrId > 0)
        { <p class="text-muted">Carregando...</p> }
        @if (_detail != null && _blockedMessage == null)
        {
            <p class="small">Conta @_btrId — @_detail.ClientName</p>
            <div class="row g-2">
                <div class="col-12 col-md-4">
                    <label class="form-label">Método de pagamento</label>
                    <select class="form-select form-select-sm" @bind="_paymentMethodId">
                        @foreach (var pm in _paymentMethods)
                        {
                            if (pm.Id == 0) continue;
                            <option value="@pm.Id">@pm.Name</option>
                        }
                    </select>
                </div>
            </div>
            <div class="mt-3">
                <button type="button" class="btn btn-primary btn-sm" @onclick="Save" disabled="@_saving">@(_saving ? "Salvando..." : "Salvar")</button>
                <a href="/financeiro/contas-a-receber/consultar" class="btn btn-secondary btn-sm ms-2">Voltar</a>
            </div>
        }
        @if (_blockedMessage != null)
        {
            <a href="/financeiro/contas-a-receber/consultar" class="btn btn-secondary btn-sm">Voltar</a>
        }
    </div>
</div>

@code {
    private int _btrId;
    private byte _termNo;
    private BillsToReceiveDetailDto? _detail;
    private byte _paymentMethodId;
    private IReadOnlyList<PaymentMethodRefDto> _paymentMethods = new List<PaymentMethodRefDto>();
    private bool _saving;
    private string? _error;
    private string? _blockedMessage;

    [Inject] private IUpdateBillsToReceiveService UpdateService { get; set; } = null!;
    [Inject] private IClientReferenceService ClientReference { get; set; } = null!;
    [Inject] private NavigationManager Navigation { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        _paymentMethods = await ClientReference.GetPaymentMethodsAsync();
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var q = ParseQuery(uri.Query);
        if (!int.TryParse(q.GetValueOrDefault("BTR_ID"), out _btrId) || _btrId <= 0)
        { _error = "Parâmetro BTR_ID é obrigatório."; return; }
        _termNo = byte.TryParse(q.GetValueOrDefault("TERM_NO"), out var tn) ? tn : (byte)1;
        var hasPayment = await UpdateService.HasPaymentAsync(_btrId);
        if (hasPayment)
        {
            _blockedMessage = "Não é possível alterar o método de pagamento para contas que já possuem baixa.";
            return;
        }
        _detail = await UpdateService.GetDetailAsync(_btrId, _termNo);
        if (_detail == null) { _error = "Conta não encontrada."; return; }
        _paymentMethodId = _detail.PaymentMethodId;
        if (_paymentMethodId == 0 && _paymentMethods.Count > 1)
            _paymentMethodId = (byte)_paymentMethods.First(p => p.Id != 0).Id;
    }

    private async Task Save()
    {
        _saving = true; _error = null;
        try
        {
            await UpdateService.UpdatePaymentMethodAsync(_btrId, _termNo, _paymentMethodId);
            Navigation.NavigateTo("/financeiro/contas-a-receber/consultar", forceLoad: true);
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _saving = false; StateHasChanged(); }
    }

    private static Dictionary<string, string> ParseQuery(string query)
    {
        var d = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        foreach (var part in (query ?? "").TrimStart('?').Split('&'))
        { var kv = part.Split('=', 2, StringSplitOptions.None); if (kv.Length == 2 && !string.IsNullOrEmpty(kv[0])) d[kv[0].Trim()] = Uri.UnescapeDataString(kv[1].Trim()); }
        return d;
    }
}
