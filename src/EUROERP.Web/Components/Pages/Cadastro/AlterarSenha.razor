@page "/cadastro/alterar-senha"
@using System.Security.Claims
@using EUROERP.Application.Account
@attribute [Authorize]
@rendermode InteractiveServer

<PageTitle>Alterar senha</PageTitle>

<div class="card mb-3">
    <div class="card-header">
        <h5 class="mb-0">Mude sua senha</h5>
    </div>
    <div class="card-body">
        @if (!string.IsNullOrEmpty(_message))
        {
            <div class="alert @(_messageSuccess ? "alert-success" : "alert-danger") py-2 mb-3">@_message</div>
        }

        @if (!_userId.HasValue)
        {
            <p class="text-warning mb-0">Usuário não identificado.</p>
        }
        else
        {
            <div class="row g-2">
                <div class="col-12 col-md-4">
                    <label class="form-label">Senha atual *</label>
                    <input type="password" class="form-control form-control-sm" @bind="_currentPassword" maxlength="10" autocomplete="current-password" />
                    <span class="text-danger small">@_currentError</span>
                </div>
            </div>
            <div class="row g-2 mt-1">
                <div class="col-12 col-md-4">
                    <label class="form-label">Nova senha *</label>
                    <input type="password" class="form-control form-control-sm" @bind="_newPassword" maxlength="10" autocomplete="new-password" />
                    <span class="text-danger small">@_newError</span>
                    <span class="small text-muted d-block">7 a 10 caracteres, letras e números</span>
                </div>
                <div class="col-12 col-md-4">
                    <label class="form-label">Confirme nova senha *</label>
                    <input type="password" class="form-control form-control-sm" @bind="_confirmPassword" maxlength="10" autocomplete="new-password" />
                    <span class="text-danger small">@_confirmError</span>
                </div>
            </div>
            <div class="mt-3">
                <button type="button" class="btn btn-primary btn-sm" @onclick="ChangeAsync" disabled="@_saving">@(_saving ? "Alterando..." : "Alterar a senha")</button>
                <a class="btn btn-outline-secondary btn-sm ms-1" href="/">Cancelar</a>
            </div>
        }
    </div>
</div>

@code {
    [Inject] private IAccountService AccountService { get; set; } = null!;
    [Inject] private AuthenticationStateProvider AuthState { get; set; } = null!;

    private Guid? _userId;
    private string _currentPassword = "";
    private string _newPassword = "";
    private string _confirmPassword = "";
    private string? _currentError;
    private string? _newError;
    private string? _confirmError;
    private bool _saving;
    private string? _message;
    private bool _messageSuccess;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync().ConfigureAwait(false);
        var idClaim = auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (Guid.TryParse(idClaim, out var userId))
            _userId = userId;
    }

    private bool Validate()
    {
        _currentError = _newError = _confirmError = null;
        var ok = true;
        if (string.IsNullOrEmpty(_currentPassword))
        {
            _currentError = "A senha atual é necessária.";
            ok = false;
        }
        if (string.IsNullOrEmpty(_newPassword))
        {
            _newError = "Digite a nova senha.";
            ok = false;
        }
        else if (_newPassword.Length < 7 || _newPassword.Length > 10)
        {
            _newError = "A nova senha deve ter entre 7 e 10 caracteres.";
            ok = false;
        }
        else if (!_newPassword.Any(char.IsLetter) || !_newPassword.Any(char.IsDigit))
        {
            _newError = "A nova senha deve conter letras e números.";
            ok = false;
        }
        if (_newPassword != _confirmPassword)
        {
            _confirmError = "A confirmação da nova senha deve ser igual a nova senha.";
            ok = false;
        }
        return ok;
    }

    private async Task ChangeAsync()
    {
        if (!_userId.HasValue || _saving) return;
        if (!Validate())
        {
            StateHasChanged();
            return;
        }
        _saving = true;
        _message = null;
        try
        {
            var result = await AccountService.ChangePasswordAsync(_userId.Value, _currentPassword, _newPassword).ConfigureAwait(false);
            _message = result.Message;
            _messageSuccess = result.Success;
            if (result.Success)
                _currentPassword = _newPassword = _confirmPassword = "";
        }
        catch (Exception ex)
        {
            _message = ex.Message;
            _messageSuccess = false;
        }
        finally
        {
            _saving = false;
            StateHasChanged();
        }
    }
}
