@page "/cadastro/alterar-email"
@using System.Security.Claims
@using EUROERP.Application.Account
@attribute [Authorize]
@rendermode InteractiveServer

<PageTitle>Alterar e-mail</PageTitle>

<div class="card mb-3">
    <div class="card-header">
        <h5 class="mb-0">Alterar e-mail</h5>
    </div>
    <div class="card-body">
        @if (!string.IsNullOrEmpty(_message))
        {
            <div class="alert @(_messageSuccess ? "alert-success" : "alert-danger") py-2 mb-3">@_message</div>
        }

        @if (!_userId.HasValue)
        {
            <p class="text-warning mb-0">Usuário não identificado.</p>
        }
        else
        {
            <div class="row g-2">
                <div class="col-12 col-md-4">
                    <label class="form-label">Usuário</label>
                    <input type="text" class="form-control form-control-sm" value="@_userName" disabled />
                </div>
            </div>
            <div class="row g-2 mt-1">
                <div class="col-12 col-md-4">
                    <label class="form-label">E-mail *</label>
                    <input type="text" class="form-control form-control-sm" @bind="_email" maxlength="256" autocomplete="email" />
                    <span class="text-danger small">@_emailError</span>
                </div>
            </div>
            <div class="mt-3">
                <button type="button" class="btn btn-primary btn-sm" @onclick="ChangeAsync" disabled="@_saving">@(_saving ? "Alterando..." : "Alterar")</button>
                <a class="btn btn-outline-secondary btn-sm ms-1" href="/">Cancelar</a>
            </div>
        }
    </div>
</div>

@code {
    [Inject] private IAccountService AccountService { get; set; } = null!;
    [Inject] private AuthenticationStateProvider AuthState { get; set; } = null!;

    private Guid? _userId;
    private string _userName = "";
    private string _email = "";
    private string? _emailError;
    private bool _saving;
    private string? _message;
    private bool _messageSuccess;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync().ConfigureAwait(false);
        _userName = auth.User.Identity?.Name ?? "";
        var idClaim = auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (Guid.TryParse(idClaim, out var userId))
        {
            _userId = userId;
            try
            {
                _email = await AccountService.GetEmailAsync(userId).ConfigureAwait(false) ?? "";
            }
            catch
            {
                _email = "";
            }
        }
    }

    private bool Validate()
    {
        _emailError = null;
        if (string.IsNullOrWhiteSpace(_email))
        {
            _emailError = "Digite o email!";
            return false;
        }
        return true;
    }

    private async Task ChangeAsync()
    {
        if (!_userId.HasValue || _saving) return;
        if (!Validate())
        {
            StateHasChanged();
            return;
        }
        _saving = true;
        _message = null;
        try
        {
            var result = await AccountService.ChangeEmailAsync(_userId.Value, _email).ConfigureAwait(false);
            _message = result.Message;
            _messageSuccess = result.Success;
        }
        catch (Exception ex)
        {
            _message = ex.Message;
            _messageSuccess = false;
        }
        finally
        {
            _saving = false;
            StateHasChanged();
        }
    }
}
